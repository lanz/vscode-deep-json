{
  "$schema": "vscode://schemas/color-theme",
  "name": "Deep JSON: Monokai Neue",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#252526",
    "editor.foreground": "#f8f8f2",
    "editorCursor.foreground": "#f8f8f0",
    "editor.lineHighlightBackground": "#333333",
    "editor.selectionBackground": "#444444",
    "editorWhitespace.foreground": "#3b3a32",
    "editor.findMatchHighlightBackground": "#ffe792",
    "editorLineNumber.foreground": "#7C7865",
    "editorBracketMatch.background": "#252526",
    "editorBracketMatch.border": "#f8f8f2a5",
    "editorBracketHighlight.foreground1": "#66D9EF",
    "editorBracketHighlight.foreground2": "#AE81FF",
    "editorBracketHighlight.foreground3": "#F92672",
    "editorBracketHighlight.foreground4": "#A6E22E",
    "editorBracketHighlight.foreground5": "#FD971F",
    "editorBracketHighlight.foreground6": "#E6DB74",
    "editorBracketHighlight.unexpectedBracket.foreground": "#FF5370",
    "editorIndentGuide.background1": "#3E737E30",
    "editorIndentGuide.activeBackground1": "#66D9EFB0"
  },
  "tokenColors": [
    {
      "scope": "comment",
      "settings": {
        "foreground": "#77777E"
      },
      "name": "Comment"
    },
    {
      "scope": "string",
      "settings": {
        "foreground": "#e6db74"
      },
      "name": "String"
    },
    {
